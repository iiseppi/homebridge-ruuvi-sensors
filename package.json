{
  "name": "homebridge-ruuvi-sensors",
  "displayName": "Ruuvi Sensors",
  "type": "module",
  "version": "1.0.2",
  "private": false,
  "description": "A modern Homebridge Dynamic Platform for Ruuvi sensors. Supports Ruuvi Gateway webhooks, local Bluetooth scanning, and all Ruuvi data formats including encrypted format 8.",
  "author": "iiseppi",
  "license": "Apache-2.0",
  "homepage": "https://github.com/iiseppi/homebridge-ruuvi-sensors#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/iiseppi/homebridge-ruuvi-sensors.git"
  },
  "bugs": {
    "url": "https://github.com/iiseppi/homebridge-ruuvi-sensors/issues"
  },
  "keywords": [
    "homebridge-plugin",
    "homebridge",
    "ruuvi",
    "ruuvitag",
    "gateway",
    "matter",
    "bluetooth",
    "weather"
  ],
  "main": "dist/index.js",
  "files": [
    "dist",
    "config.schema.json"
  ],
  "engines": {
    "node": ">=22.0.0",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "lint": "eslint . --max-warnings=0",
    "prepublishOnly": "npm run lint && npm run build",
    "watch": "npm run build && npm link && nodemon"
  },
  "dependencies": {
    "@abandonware/noble": "^1.9.2-22",
    "fakegato-history": "^0.6.2",
    "homebridge-lib": "^8.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "eslint": "^10.3.0",
    "homebridge": "^2.0.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2"
  }
}
